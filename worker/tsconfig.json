{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "src",
    "test",
    "../src/data/trip.ts",
    "../src/data/facts.ts",
    "../src/lib/facts/types.ts",
    "../src/lib/currency/rates.ts",
    "../src/lib/itinerary/types.ts",
    "../src/lib/weather/openMeteo.ts",
    "../src/data/zones.ts",
    "../src/lib/itinerary/plan.ts",
    "../src/data/dishes.ts",
    "../src/lib/food/types.ts",
    "../src/lib/sync/protocol.ts",
    "../src/data/album.ts",
    "../src/lib/album/protocol.ts",
    "../src/lib/album/jpeg.ts",
    "../src/lib/album/moments.ts",
    "../src/game/constants.ts",
    "../src/game/scores.ts"
  ]
}
